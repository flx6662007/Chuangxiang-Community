# 复制为 backend/.env 后填写自己的值；真实 .env 不提交到仓库。
# 密钥可用 Django 的 get_random_secret_key() 生成，方法见开发说明。
DJANGO_SECRET_KEY=replace-with-your-local-random-key
# 1 为本地调试模式；正式部署设为 0。
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 公开赛事列表限定学校目录（包括全部学科），迁移后执行 init_competition_catalog。
COMPETITION_CATALOG_ONLY=1
# 定时提取官网原文；确认使用现有赛事维护账号后再启用自动发布。
CATALOG_AUTO_PUBLISH=0
CATALOG_PUBLISH_ACTOR_ID=
# 以下数据库和用户须先在本机 PostgreSQL 中创建。
DB_NAME=chuangxiang_dev
DB_USER=chuangxiang_dev
DB_PASSWORD=replace-with-your-local-password
DB_HOST=127.0.0.1
DB_PORT=5432

# 本地免费开发：邮件打印在后端终端，不会真正发送。
DJANGO_PUBLIC_ORIGIN=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=创享平台 <noreply@example.org>
# 正式部署使用 deploy/.env.example，必须启用真实 SMTP、HTTPS 和 Redis。

# AI 默认关闭；填写服务端配置并设为 1 后，业务代码才能主动调用。
# BASE_URL 填服务控制台的兼容接口地址（截止到 /v1，不含 /chat/completions）。
AI_ENABLED=0
AI_PROVIDER=qwen
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048

# 首页 AI 助手：只在本机 backend/.env 填写真实密钥，不放到任何 VITE_* 变量。
# 不需要打开上面的 AI_ENABLED（该开关只控制原有内部草稿服务）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_OUTPUT_TOKENS=2048
