# 复制为 backend/.env 后填写自己的值；真实 .env 不提交到仓库。
# 密钥可用 Django 的 get_random_secret_key() 生成，方法见开发说明。
DJANGO_SECRET_KEY=replace-with-your-local-random-key
# 1 为本地调试模式；正式部署设为 0。
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 以下数据库和用户须先在本机 PostgreSQL 中创建。
DB_NAME=chuangxiang_dev
DB_USER=chuangxiang_dev
DB_PASSWORD=replace-with-your-local-password
DB_HOST=127.0.0.1
DB_PORT=5432

# AI 默认关闭；填写服务端配置并设为 1 后，业务代码才能主动调用。
# BASE_URL 填服务控制台的兼容接口地址（截止到 /v1，不含 /chat/completions）。
AI_ENABLED=0
AI_PROVIDER=qwen
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048
