# Copy to <repository>/.local/private-beta/chuangxiang_beta_20261006_ai/.env.
# Use an existing, separate PostgreSQL database. Fill every replace-with value.
# Use forward slashes for Windows absolute paths; quote paths containing spaces.
PRIVATE_BETA_ORIGIN=https://pending.example.com
PRIVATE_BETA_USERNAME=chuangxiang-beta
PRIVATE_BETA_PASSWORD=replace-with-random-entry-password-at-least-24-characters
PRIVATE_BETA_SECRET_KEY=replace-with-random-django-secret-at-least-50-characters
PRIVATE_BETA_DB_NAME=chuangxiang_beta_20261006_ai
PRIVATE_BETA_DB_USER=replace-with-local-db-user
PRIVATE_BETA_DB_PASSWORD=replace-with-local-db-password
PRIVATE_BETA_DB_HOST=127.0.0.1
PRIVATE_BETA_DB_PORT=5432
PRIVATE_BETA_STATE_DIR="C:/absolute/repository/.local/private-beta/chuangxiang_beta_20261006_ai"
PRIVATE_BETA_FRONTEND_DIST="C:/absolute/repository/.local/private-beta/chuangxiang_beta_20261006_ai/frontend-dist"
COMPETITION_EMBEDDING_MODEL_PATH="C:/absolute/repository/.local/models/bge-small-zh-v1.5"
COMPETITION_SEMANTIC_INDEX="C:/absolute/repository/.local/competition-search/database.npz"
PUBLIC_RESEARCH_ENABLED=0
# Keep the real DEEPSEEK_* values in backend/.env. Never copy them to frontend.
