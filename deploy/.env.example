# 复制为 deploy/.env 后填写；不提交 .env，不把密钥放入前端。
# DOMAIN 只填域名，不含 https://、路径和端口。
DOMAIN=replace-with-your-domain
ACME_EMAIL=replace-with-certificate-contact-email
DJANGO_SECRET_KEY=replace-with-random-secret

DB_NAME=chuangxiang
DB_USER=chuangxiang_app
DB_PASSWORD=replace-with-random-app-db-password
POSTGRES_PASSWORD=replace-with-different-postgres-admin-password
# 使用独立的 URL 安全随机串（字母、数字、-、_），避免 URL 中特殊符号歧义。
REDIS_PASSWORD=replace-with-random-redis-password

# 发件服务提供的 SMTP 参数；不是注册同学的学校邮箱密码。
EMAIL_HOST=replace-with-smtp-host
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password-or-token
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=replace-with-approved-sender-address
EMAIL_TIMEOUT=10

# 默认不产生模型调用费用；确认模型服务后再配置、开启。
AI_ENABLED=0
AI_PROVIDER=qwen
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048

